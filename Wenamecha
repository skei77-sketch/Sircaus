<script>
  let bugCount = 0;
  let unlockedTrophies = new Set();
  let isWenamechaActive = false;
  let currentThemeName = 'default';

  /* SVGs DEL BOSS DETALLADOS */
  const bossSVGs = {
    default: `<svg viewBox="0 0 300 300" width="290" height="290"><circle cx="150" cy="150" r="130" fill="rgba(255,0,85,0.2)"/><path d="M 60 100 Q 30 40 10 20 Q 50 30 85 75 Z" fill="#FF0055"/><path d="M 240 100 Q 270 40 290 20 Q 250 30 215 75 Z" fill="#FF0055"/><path d="M 150 40 Q 230 40 240 130 Q 250 220 150 270 Q 50 220 60 130 Q 70 40 150 40 Z" fill="#12020A" stroke="#FF0055" stroke-width="6"/><polygon points="85,115 130,135 90,145" fill="#FF0055"/><polygon points="215,115 170,135 210,145" fill="#FF0055"/></svg>`,
    matrix: `<svg viewBox="0 0 300 300" width="290" height="290"><path d="M 150 30 L 250 80 L 270 190 L 150 270 L 30 190 L 50 80 Z" fill="#021206" stroke="#00FF66" stroke-width="5"/></svg>`,
    silksong: `<svg viewBox="0 0 300 300" width="290" height="290"><path d="M 150 20 C 240 -10 280 80 260 160 C 240 230 180 280 150 280 C 120 280 60 230 40 160 C 20 80 60 -10 150 20 Z" fill="#F4F4F7" stroke="#120307" stroke-width="8"/></svg>`,
    cyberpunk: `<svg viewBox="0 0 300 300" width="290" height="290"><polygon points="150,20 250,50 280,140 230,250 70,250 20,140 50,50" fill="#10121A" stroke="#00F0FF" stroke-width="6"/></svg>`,
    hollow: `<svg viewBox="0 0 300 300" width="290" height="290"><circle cx="150" cy="150" r="80" fill="#FFFDE0" stroke="#FFD700" stroke-width="8"/></svg>`,
    cubito: `<svg viewBox="0 0 300 300" width="290" height="290"><rect x="40" y="40" width="220" height="220" fill="#181818" stroke="#55FF55" stroke-width="8"/></svg>`,
    michi: `<svg viewBox="0 0 300 300" width="290" height="290"><ellipse cx="150" cy="160" rx="110" ry="90" fill="#3D142E" stroke="#FF66C4" stroke-width="6"/></svg>`,
    thanos: `<svg viewBox="0 0 300 300" width="290" height="290"><path d="M 150 20 Q 240 250 150 270 Q 60 250 150 20 Z" fill="#210734" stroke="#FFD700" stroke-width="7"/></svg>`
  };

  function unlockTrophy(id, title, desc, icon = '🏆') {
    if (unlockedTrophies.has(id)) return;
    unlockedTrophies.add(id);

    const card = document.getElementById(`card-${id}`);
    if (card) card.classList.add('unlocked');

    document.getElementById('trophyIcon').innerText = icon;
    document.getElementById('trophyTitle').innerText = title;
    document.getElementById('trophyDesc').innerText = desc;
    document.getElementById('trophyCount').innerText = unlockedTrophies.size;

    if (isWenamechaActive) {
      const toast = document.getElementById('trophyToast');
      toast.classList.add('active-mode', 'show');
      playSuccessSound();
      setTimeout(() => toast.classList.remove('show'), 4000);
    }

    if (unlockedTrophies.size >= 11 && !unlockedTrophies.has('pajin')) {
      setTimeout(() => {
        unlockTrophy('pajin', 'PAJIN SUPREMO', 'Completaste el 100% de la página web.', '👑');
        document.getElementById('pajinOverlay').classList.add('show');
      }, 1000);
    }
  }

  function closePajinOverlay() {
    document.getElementById('pajinOverlay').classList.remove('show');
  }

  function toggleTech(card) {
    card.classList.toggle('open');
    unlockTrophy('tech', 'Lector de Código', 'Has inspeccionado la ficha técnica del ESP32.', '🔍');
  }

  function restoreElements() {
    document.querySelectorAll('.thanos-dust').forEach(el => el.classList.remove('thanos-dust'));
    document.querySelectorAll('.mined-block').forEach(el => el.classList.remove('mined-block'));
  }

  function setTheme(theme) {
    restoreElements();
    currentThemeName = theme;
    document.body.classList.remove('theme-matrix', 'theme-cyberpunk', 'theme-michi', 'theme-hollow', 'theme-silksong', 'theme-cubito', 'theme-thanos');
    
    if (theme === 'matrix') { document.body.classList.add('theme-matrix'); initMatrixRain(); }
    if (theme === 'cyberpunk') document.body.classList.add('theme-cyberpunk');
    if (theme === 'michi') {
      document.body.classList.add('theme-michi');
      unlockTrophy('michi', 'Michi-Hacker', 'Convertiste el sistema a temática de gatitos.', '🐾');
    }
    if (theme === 'hollow' || theme === 'silksong') {
      document.body.classList.add(`theme-${theme}`);
      unlockTrophy('hollow', 'Caballero del Vacío', 'Has invocado la atmósfera de Hollow Knight o Silksong.', '🌌');
    }
    if (theme === 'cubito') {
      document.body.classList.add('theme-cubito');
      unlockTrophy('cubito', 'Minería Legendaria', 'Mundo de bloques activado.', '⛏️');
    }
  }

  let avalonClicks = 0;
  let avalonTimeLeft = 5.0;
  let avalonTimer = null;
  let avalonActive = false;

  function applyBossSkin() {
    const bossEl = document.getElementById('avalonBoss');
    const titleEl = document.getElementById('avalonTitle');
    const overlayEl = document.getElementById('avalonOverlay');

    overlayEl.className = 'avalon-overlay';
    bossEl.innerHTML = bossSVGs[currentThemeName] || bossSVGs.default;

    if (currentThemeName === 'silksong') {
      overlayEl.classList.add('bg-silksong');
      titleEl.innerText = '¡DESAFÍO DE SEDA!';
      titleEl.style.color = '#FF1A4B';
    } else if (currentThemeName === 'matrix') {
      overlayEl.classList.add('bg-matrix');
      titleEl.innerText = '¡PURGA LA ANOMALÍA!';
      titleEl.style.color = '#00FF66';
    } else if (currentThemeName === 'hollow') {
      overlayEl.classList.add('bg-hollow');
      titleEl.innerText = '¡DERROTA AL DESTELLO!';
      titleEl.style.color = '#FFD700';
    } else if (currentThemeName === 'cyberpunk') {
      overlayEl.classList.add('bg-cyberpunk');
      titleEl.innerText = '¡HACKEA A ADAM SMASHER!';
      titleEl.style.color = '#F2F500';
    } else if (currentThemeName === 'michi') {
      overlayEl.classList.add('bg-michi');
      titleEl.innerText = '¡RETAN A MICHI LUNA!';
      titleEl.style.color = '#FF66C4';
    } else if (currentThemeName === 'cubito') {
      overlayEl.classList.add('bg-cubito');
      titleEl.innerText = '¡DERROTA AL ENDER DRAGON!';
      titleEl.style.color = '#55FF55';
    } else if (currentThemeName === 'thanos') {
      overlayEl.classList.add('bg-thanos');
      titleEl.innerText = '¡RESISTE EL GUANTELETE!';
      titleEl.style.color = '#CC99FF';
    } else {
      titleEl.innerText = '¡RETO DE AVALON!';
      titleEl.style.color = '#FF0055';
    }
  }

  function startAvalonBoss(e) {
    if (e) { e.preventDefault(); e.target.blur(); }
    if (avalonActive) return;

    applyBossSkin();
    avalonClicks = 0;
    avalonTimeLeft = 5.0;
    avalonActive = true;
    
    document.getElementById('avalonClicksVal').innerText = '0';
    document.getElementById('avalonTimeVal').innerText = '5.0';
    document.getElementById('avalonTimerBar').style.width = '100%';
    document.getElementById('avalonOverlay').classList.add('show');

    if (avalonTimer) clearInterval(avalonTimer);

    avalonTimer = setInterval(() => {
      avalonTimeLeft -= 0.1;
      if (avalonTimeLeft <= 0) {
        avalonTimeLeft = 0;
        clearInterval(avalonTimer);
        avalonActive = false;
        document.getElementById('avalonOverlay').classList.remove('show');
        if (avalonClicks < 50) alert('⏰ ¡SE ACABÓ EL TIEMPO! El Boss te ha vencido.');
      }
      document.getElementById('avalonTimeVal').innerText = Math.max(0, avalonTimeLeft).toFixed(1);
      document.getElementById('avalonTimerBar').style.width = Math.max(0, (avalonTimeLeft / 5 * 100)) + '%';
    }, 100);
  }

  function hitAvalon() {
    if (!avalonActive) return;
    avalonClicks++;
    playClickSound();
    document.getElementById('avalonClicksVal').innerText = avalonClicks;

    if (avalonClicks >= 50 && avalonTimeLeft > 0) {
      clearInterval(avalonTimer);
      avalonActive = false;
      document.getElementById('avalonOverlay').classList.remove('show');
      unlockTrophy('avalon', 'Destructor de BOSS', 'Hiciste 50 clics en 5 segundos y destruiste al Boss.', '👾');
      playSuccessSound();
    }
  }

  /* PONG LCD */
  let pongCanvas, pongCtx;
  let pPlayerY = 75, pAiY = 75;
  let pBallX = 200, pBallY = 100, pBallSpeedX = 4, pBallSpeedY = 3;
  let pPlayerScore = 0, pAiScore = 0;
  let pongRunning = false;
  let pongAnimId = null;

  function movePongPaddle(offset) { pPlayerY = Math.max(10, Math.min(140, pPlayerY + offset)); }
  function stopPongGame() {
    pongRunning = false;
    if (pongAnimId) cancelAnimationFrame(pongAnimId);
  }

  function startPongGame() {
    if (pongRunning) return;
    pongCanvas = document.getElementById('pongCanvas');
    pongCtx = pongCanvas.getContext('2d');
    pongRunning = true;
    pPlayerScore = 0; pAiScore = 0; pBallX = 200; pBallY = 100;
    
    function loop() {
      if (!pongRunning) return;
      pBallX += pBallSpeedX; pBallY += pBallSpeedY;
      if (pBallY <= 5 || pBallY >= 195) pBallSpeedY *= -1;
      if (pBallY > pAiY + 25) pAiY += 2.2;
      else if (pBallY < pAiY + 25) pAiY -= 2.2;

      if (pBallX <= 22 && pBallY >= pPlayerY && pBallY <= pPlayerY + 50) { pBallSpeedX *= -1; playClickSound(); }
      if (pBallX >= 370 && pBallY >= pAiY && pBallY <= pAiY + 50) { pBallSpeedX *= -1; }

      if (pBallX <= 0) { pAiScore++; pBallX = 200; pBallY = 100; }
      if (pBallX >= 400) { pPlayerScore++; pBallX = 200; pBallY = 100; }

      if (pPlayerScore >= 20) unlockTrophy('pong', 'Maestro del Pong LCD', 'Anotaste 20 puntos en la pantalla LCD del ESP32.', '🏓');

      pongCtx.fillStyle = '#000'; pongCtx.fillRect(0, 0, 400, 200);
      pongCtx.fillStyle = '#00FF66';
      pongCtx.fillRect(10, pPlayerY, 12, 50);
      pongCtx.fillRect(378, pAiY, 12, 50);
      pongCtx.fillRect(pBallX, pBallY, 8, 8);
      pongCtx.font = '12px monospace';
      pongCtx.fillText(`TÚ: ${pPlayerScore} | ESP32: ${pAiScore}`, 130, 20);

      pongAnimId = requestAnimationFrame(loop);
    }
    loop();
  }

  let matrixInterval = null;
  function initMatrixRain() {
    if (matrixInterval) return;
    const canvas = document.getElementById('matrixCanvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    const chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
    const fontSize = 14;
    const columns = Math.floor(canvas.width / fontSize);
    const drops = Array(columns).fill(1);

    matrixInterval = setInterval(() => {
      ctx.fillStyle = 'rgba(2, 10, 5, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00FF66';
      ctx.font = fontSize + 'px monospace';
      for (let i = 0; i < drops.length; i++) {
        const text = chars.charAt(Math.floor(Math.random() * chars.length));
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }, 33);
  }

  let miningTimer = null;
  let currentTarget = null;
  document.addEventListener('mousedown', (e) => {
    if (!document.body.classList.contains('theme-cubito')) return;
    const target = e.target.closest('p, h1, h2, h3, .card-num, .tech-card, .status-card, .node-box, button');
    if (!target) return;
    currentTarget = target;
    currentTarget.classList.add('mining-active');
    miningTimer = setTimeout(() => {
      if (currentTarget) {
        currentTarget.classList.remove('mining-active');
        currentTarget.classList.add('mined-block');
        playClickSound();
        unlockTrophy('minero', '¡Minero Profesional!', 'Picaste y minaste una sección en Modo Cubito.', '🧱');
      }
    }, 600);
  });

  document.addEventListener('mouseup', () => {
    if (miningTimer) clearTimeout(miningTimer);
    if (currentTarget) currentTarget.classList.remove('mining-active');
  });

  function activateThanosMode() {
    restoreElements();
    setTheme('thanos');
    playSuccessSound();
    const overlay = document.getElementById('thanosOverlay');
    overlay.classList.add('show');
    setTimeout(() => {
      overlay.classList.remove('show');
      document.querySelectorAll('p, h1, h2, h3, .card-num, .process-item, .tech-card, tr, .node-box').forEach((el, index) => {
        if (index % 2 === 0) el.classList.add('thanos-dust');
      });
      unlockTrophy('thanos', 'Equilibrio Perfecto', 'Has reducido la mitad de los textos a polvo.', '🫰');
    }, 2200);
  }

  function spawnBug() {
    const bug = document.createElement('div');
    bug.className = 'code-bug'; bug.innerText = '🪲';
    bug.style.left = (Math.random() * (window.innerWidth - 60)) + 'px';
    bug.style.top = (Math.random() * (window.innerHeight - 60)) + 'px';

    bug.onclick = function(e) {
      bugCount++;
      document.getElementById('bugCount').innerText = bugCount;
      const pop = document.createElement('div');
      pop.className = 'bug-pop'; pop.innerText = '¡DEBUGGED! +100 XP';
      pop.style.left = e.clientX + 'px'; pop.style.top = e.clientY + 'px';
      document.body.appendChild(pop);
      setTimeout(() => pop.remove(), 800);
      bug.remove();
      playClickSound();
      unlockTrophy('bug', 'Cazador de Bugs', 'Has depurado tu primer insecto de código.', '🪲');
    };
    document.body.appendChild(bug);
  }

  let audioCtx = null;
  function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
  function playClickSound() {
    initAudio();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
    osc.type = 'square'; osc.frequency.setValueAtTime(440, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(220, audioCtx.currentTime + 0.05);
    gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.05);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(); osc.stop(audioCtx.currentTime + 0.05);
  }
  function playSuccessSound() {
    initAudio();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const notes = [{ f: 523.25, d: 0.1 }, { f: 659.25, d: 0.1 }, { f: 783.99, d: 0.1 }, { f: 1046.50, d: 0.35 }];
    let now = audioCtx.currentTime;
    notes.forEach(note => {
      const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
      osc.type = 'triangle'; osc.frequency.setValueAtTime(note.f, now);
      gain.gain.setValueAtTime(0.2, now); gain.gain.exponentialRampToValueAtTime(0.001, now + note.d);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + note.d);
      now += note.d + 0.02;
    });
  }

  const konamiCode = ['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'b', 'a'];
  let currentStep = 0;
  const keyMap = { 'ArrowUp': 'up', 'ArrowDown': 'down', 'ArrowLeft': 'left', 'ArrowRight': 'right', 'b': 'b', 'B': 'b', 'a': 'a', 'A': 'a' };

  function handleInput(key) {
    playClickSound();
    const btn = document.querySelector(`[data-key="${key}"]`);
    if (btn) { btn.classList.add('active'); setTimeout(() => btn.classList.remove('active'), 150); }
    if (key === konamiCode[currentStep]) {
      currentStep++;
      if (currentStep === konamiCode.length) { setTimeout(() => activateWenamechaMode(), 100); currentStep = 0; }
    } else { currentStep = (key === konamiCode[0]) ? 1 : 0; }
  }

  document.querySelectorAll('.k-btn').forEach(button => {
    button.addEventListener('click', () => handleInput(button.getAttribute('data-key')));
  });

  window.addEventListener('keydown', (e) => {
    if (pongRunning) {
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        movePongPaddle(-25);
        e.preventDefault();
      } else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        movePongPaddle(25);
        e.preventDefault();
      }
    }

    if (avalonActive && e.key === ' ') {
      hitAvalon();
      e.preventDefault();
    }

    if (keyMap[e.key]) handleInput(keyMap[e.key]);
  });

  function activateWenamechaMode() {
    isWenamechaActive = true;
    document.body.classList.add('wenamecha-active');
    document.getElementById('fullscreenOverlay').classList.add('show');

    if (!document.getElementById('wenamechaTab')) {
      const navContainer = document.getElementById('navContainer');
      const newTab = document.createElement('a');
      newTab.href = '#wenamecha-section';
      newTab.id = 'wenamechaTab';
      newTab.className = 'secret-tab';
      newTab.textContent = '★ Wenamecha';
      navContainer.appendChild(newTab);
    }

    document.getElementById('achievementsBar').classList.add('show');
    document.getElementById('wenamechaBox').classList.add('active');
    unlockTrophy('wenamecha', 'Desarrollador Legendario', 'Has introducido el Código Konami con éxito.', '⭐');
  }

  function closeOverlay() { document.getElementById('fullscreenOverlay').classList.remove('show'); }

  /* SIMULADOR NFC, DASHBOARD Y NOTIFICACIONES PUSH */
  function simularEscaneo(nombre, uid, grado, autorizado) {
    const tableBody = document.getElementById('mockTableBody');
    const notifList = document.getElementById('notifList');
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    // Actualizar Tabla Dashboard
    const newRow = document.createElement('tr');
    newRow.className = 'new-row';
    if (autorizado) {
      newRow.innerHTML = `<td>${uid}</td><td>${nombre}</td><td>${grado}</td><td>${timeStr}</td><td><span class="pill-status ok">Presente</span></td>`;
    } else {
      newRow.innerHTML = `<td>${uid}</td><td>UID no registrado</td><td>—</td><td>${timeStr}</td><td><span class="pill-status bad">Rechazado</span></td>`;
    }
    tableBody.insertBefore(newRow, tableBody.firstChild);
    if (tableBody.children.length > 5) tableBody.removeChild(tableBody.lastChild);

    // Actualizar Notificación Dashboard
    const notifItem = document.createElement('div');
    notifItem.className = 'notif-item';
    if (autorizado) {
      notifItem.innerHTML = `<span class="notif-dot"></span><p>Se registró la asistencia de <strong>${nombre}</strong><span>ahora mismo</span></p>`;
    } else {
      notifItem.innerHTML = `<span class="notif-dot bad"></span><p>Intento no autorizado: <strong>${uid}</strong><span>ahora mismo</span></p>`;
    }
    notifList.insertBefore(notifItem, notifList.firstChild);
    if (notifList.children.length > 4) notifList.removeChild(notifList.lastChild);

    // Actualizar Notificación Push Móvil
    const pushBody = document.getElementById('pushNotifBody');
    const phoneClock = document.getElementById('phoneClock');
    const timeShort = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    phoneClock.innerText = timeShort;

    if (autorizado) {
      pushBody.innerText = `${nombre} (${grado}) ingresó a la institución a las ${timeShort}.`;
    } else {
      pushBody.innerText = `Intento de acceso denegado con manilla no registrada (${uid}) a las ${timeShort}.`;
    }

    const pushCard = document.getElementById('activePushNotif');
    pushCard.style.animation = 'none';
    pushCard.offsetHeight; // trigger reflow
    pushCard.style.animation = 'pushSlideDown 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
  }

  function updateCalculator(value) {
    document.getElementById('studentVal').innerText = value;
    const aulas = Math.ceil(value / 35);
    const minAhorradosDia = aulas * 9;
    const hrsMes = Math.round((minAhorradosDia * 20) / 60);
    document.getElementById('timeSavedNum').innerText = `${hrsMes} hrs`;
  }

  function scrollToSim() { document.getElementById('simuladorHero').scrollIntoView({ behavior: 'smooth' }); }

  /* COPIA DE CÓDIGO C++ MEJORADA CON CHECKMARK */
  function copyCode() {
    const codeText = document.getElementById('cppCodeBlock').innerText;
    navigator.clipboard.writeText(codeText).then(() => {
      const btn = document.getElementById('copyBtn');
      const btnIcon = document.getElementById('copyBtnIcon');
      const btnText = document.getElementById('copyBtnText');

      btn.classList.add('copied');
      btnIcon.innerText = '✓';
      btnText.innerText = '¡Copiado!';

      setTimeout(() => {
        btn.classList.remove('copied');
        btnIcon.innerText = '📋';
        btnText.innerText = 'Copiar Código';
      }, 2500);
    }).catch(err => {
      alert('Código C++ copiado al portapapeles');
    });
  }
</script>

