<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SIRCAUS — Asistencia Escolar Inteligente por NFC</title>

<!-- Meta-etiquetas Open Graph -->
<meta property="og:title" content="SIRCAUS — Asistencia escolar por NFC">
<meta property="og:description" content="Una manilla con sticker NFC, lector MFRC522 y ESP32 para asistencia escolar instantánea, sin listas de papel.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#03050B">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Cinzel:wght@500;700;900&family=Cinzel+Decorative:wght@700&family=Press+Start+2P&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #03050B;
    --bg-2: #060A14;
    --panel: rgba(13, 18, 32, 0.75);
    --panel-2: rgba(19, 26, 44, 0.85);
    --card-bg: rgba(9, 14, 26, 0.65);
    --ink: #F3F6FC;
    --ink-dim: #93A0BC;
    --muted: #5C6680;
    --accent: #4C86FF;
    --accent-2: #8FB6FF;
    --accent-deep: #2456D6;
    --ok: #55E08A;
    --bad: #F8788A;
    --gold: #FFD700;
    --rule: rgba(255, 255, 255, 0.08);
    --glass-border: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.02));
    --font-display: "Sora", sans-serif;
    --font-body: "Inter", sans-serif;
    --font-mono: "JetBrains Mono", monospace;
  }

  /* CANVAS MATRIX DE FONDO */
  #matrixCanvas {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none; display: none; opacity: 0.8;
  }

  body.theme-matrix {
    --bg: #020A05; --bg-2: #04140A; --panel: rgba(7, 32, 16, 0.85); --panel-2: #0D331A;
    --card-bg: rgba(5, 24, 12, 0.85); --ink: #E0FFE8; --ink-dim: #7ACC8E;
    --accent: #00FF66; --accent-2: #80FFB2; --accent-deep: #00B347; --rule: rgba(0,255,102,0.25);
  }
  body.theme-matrix #matrixCanvas { display: block; }

  /* MODO CYBERPUNK 2077 */
  body.theme-cyberpunk {
    --bg: #08080A; --bg-2: #12131A; --panel: rgba(26, 28, 36, 0.85); --panel-2: #252834; --card-bg: rgba(20, 21, 29, 0.85);
    --ink: #F2F500; --ink-dim: #00F0FF; --accent: #FF0055; --accent-2: #F2F500; --accent-deep: #00F0FF;
    --rule: #00F0FF; --font-display: "Orbitron", sans-serif;
  }
  body.theme-cyberpunk::before {
    content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 85, 0.05), rgba(0, 240, 255, 0.05), rgba(242, 245, 0, 0.05));
    z-index: 999; background-size: 100% 3px, 6px 100%; pointer-events: none; opacity: 0.8;
  }
  body.theme-cyberpunk h1, body.theme-cyberpunk h2, body.theme-cyberpunk .brand {
    font-family: 'Orbitron', sans-serif; letter-spacing: 2px;
    text-shadow: 3px 3px 0px #FF0055, -3px -3px 0px #00F0FF;
  }

  /* MODO MICHI */
  body.theme-michi {
    --bg: #180812; --bg-2: #2B0E20; --panel: rgba(61, 20, 46, 0.85); --panel-2: #541B3F; --card-bg: rgba(43, 11, 32, 0.85);
    --ink: #FFF0F8; --ink-dim: #E8A8D0; --accent: #FF66C4; --accent-2: #FFA8E2; --accent-deep: #CC1F93;
    --rule: rgba(255, 102, 196, 0.3);
  }

  /* MODO HOLLOW KNIGHT */
  body.theme-hollow {
    --bg: #030811; --bg-2: #071020; --panel: rgba(11, 25, 48, 0.85); --panel-2: #102445; --card-bg: rgba(9, 19, 38, 0.85);
    --ink: #E0EBFB; --ink-dim: #7C98C4; --accent: #3A82FF; --accent-2: #80B3FF; --accent-deep: #1A54C8;
    --rule: rgba(58, 130, 255, 0.2); --font-display: "Cinzel", serif;
  }

  /* MODO SILKSONG */
  body.theme-silksong {
    --bg: #0E0306; --bg-2: #1C060B; --panel: rgba(42, 9, 16, 0.85); --panel-2: #3E0C17; --card-bg: rgba(31, 5, 11, 0.85);
    --ink: #FFEAF0; --ink-dim: #D98899; --accent: #FF1A4B; --accent-2: #FF708F; --accent-deep: #B30026;
    --rule: rgba(255, 26, 75, 0.25); --font-display: "Cinzel Decorative", "Cinzel", serif;
  }

  /* MODO CUBITO */
  body.theme-cubito {
    --bg: #121A10; --bg-2: #1D2A1A; --panel: rgba(45, 62, 39, 0.85); --panel-2: #3F5736; --card-bg: rgba(34, 49, 30, 0.85);
    --ink: #E2F2DF; --ink-dim: #99C293; --accent: #55FF55; --accent-2: #AAFFAA; --accent-deep: #00AA00;
    --rule: #55FF55; --font-display: 'Press Start 2P', monospace;
  }
  .mining-active { animation: miningShake 0.15s infinite alternate ease-in-out !important; filter: brightness(1.4) drop-shadow(0 0 10px #55FF55) !important; cursor: progress !important; }
  @keyframes miningShake { 0% { transform: scale(0.98) rotate(-1deg); } 100% { transform: scale(1.02) rotate(1deg); } }
  .mined-block { animation: blockMined 0.5s forwards ease-out !important; pointer-events: none !important; }
  @keyframes blockMined { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.2) rotate(10deg); filter: blur(4px); } 100% { opacity: 0; transform: scale(0); filter: blur(10px); } }

  /* MODO THANOS */
  body.theme-thanos {
    --bg: #12041D; --bg-2: #1D062E; --panel: rgba(44, 10, 69, 0.85); --panel-2: #430F69; --card-bg: rgba(33, 7, 52, 0.85);
    --ink: #F2E6FF; --ink-dim: #B892E0; --accent: #9933FF; --accent-2: #CC99FF; --accent-deep: #6600CC;
    --rule: rgba(153, 51, 255, 0.3);
  }
  .thanos-dust { animation: thanosDisintegrate 2.5s forwards ease-in-out !important; pointer-events: none !important; }
  @keyframes thanosDisintegrate { 0% { opacity: 1; transform: translate(0, 0) rotate(0deg) scale(1); filter: blur(0px); } 50% { opacity: 0.6; filter: blur(4px); } 100% { opacity: 0; transform: translate(80px, -120px) rotate(25deg) scale(0.6); filter: blur(12px); } }

  .thanos-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(18, 4, 29, 0.95); backdrop-filter: blur(20px);
    z-index: 10001; display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
  }
  .thanos-overlay.show { opacity: 1; pointer-events: auto; }
  .thanos-msg {
    font-family: 'Cinzel Decorative', 'Cinzel', serif; font-size: clamp(2rem, 5vw, 4rem);
    color: #CC99FF; text-align: center; text-shadow: 0 0 30px #9933FF, 0 0 60px #6600CC;
  }

  /* OVERLAY BOSS FIGHT */
  .avalon-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: radial-gradient(circle at center, rgba(30, 5, 15, 0.98) 0%, rgba(5, 1, 3, 0.99) 100%);
    backdrop-filter: blur(20px); z-index: 10003; display: flex; flex-direction: column; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: all 0.4s ease; text-align: center; user-select: none; cursor: pointer;
  }
  .avalon-overlay.show { opacity: 1; pointer-events: auto; }
  .avalon-overlay.bg-silksong { background: radial-gradient(circle at center, #3E0813 0%, #170206 60%, #080002 100%) !important; box-shadow: inset 0 0 100px rgba(255, 26, 75, 0.3); }
  .avalon-overlay.bg-matrix { background: radial-gradient(circle at center, #0B3818 0%, #031408 60%, #010A04 100%) !important; box-shadow: inset 0 0 100px rgba(0, 255, 102, 0.3); }
  .avalon-overlay.bg-hollow { background: radial-gradient(circle at center, #2E280C 0%, #0C1526 60%, #030811 100%) !important; box-shadow: inset 0 0 100px rgba(255, 215, 0, 0.25); }
  .avalon-overlay.bg-cyberpunk { background: radial-gradient(circle at center, #2B2E05 0%, #12131A 60%, #06070A 100%) !important; box-shadow: inset 0 0 120px rgba(0, 240, 255, 0.3); }
  .avalon-overlay.bg-cubito { background: radial-gradient(circle at center, #1B3B18 0%, #0D1C0B 60%, #050B04 100%) !important; box-shadow: inset 0 0 100px rgba(85, 255, 85, 0.25); }
  .avalon-overlay.bg-thanos { background: radial-gradient(circle at center, #3B0D5B 0%, #150324 60%, #08010E 100%) !important; box-shadow: inset 0 0 100px rgba(153, 51, 255, 0.3); }
  .avalon-overlay.bg-michi { background: radial-gradient(circle at center, #4A1236 0%, #1F0516 60%, #0A0107 100%) !important; box-shadow: inset 0 0 100px rgba(255, 102, 196, 0.3); }

  .avalon-boss { cursor: pointer; user-select: none; animation: avalonFloat 0.8s infinite alternate ease-in-out; transition: transform 0.05s; z-index: 2; margin: 20px 0; }
  .avalon-boss svg { width: 290px; height: 290px; pointer-events: none; filter: drop-shadow(0 0 20px rgba(255, 0, 85, 0.6)); }
  .avalon-boss:active { transform: scale(0.85); }
  @keyframes avalonFloat { 0% { transform: translateY(0) rotate(-3deg); } 100% { transform: translateY(-18px) rotate(3deg); } }

  .avalon-timer-bar { width: 340px; height: 16px; background: rgba(255, 255, 255, 0.1); border: 2px solid #FF0055; border-radius: 10px; overflow: hidden; margin: 15px 0 10px; }
  .avalon-timer-fill { width: 100%; height: 100%; background: linear-gradient(90deg, #FF0055, #FF5500); transition: width 0.1s linear; }

  /* OVERLAY PAJIN SUPREMO */
  .pajin-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: radial-gradient(circle, #3A2E00 0%, #0D0A00 90%);
    z-index: 10002; display: flex; flex-direction: column; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.6s ease; text-align: center; padding: 20px;
  }
  .pajin-overlay.show { opacity: 1; pointer-events: auto; }
  .pajin-title { font-family: 'Press Start 2P', var(--font-display); font-size: clamp(2rem, 6vw, 4.5rem); color: var(--gold); text-shadow: 0 0 20px #FFD700, 0 0 40px #FF8800; }

  /* MINIJUEGO PONG LCD */
  .pong-container { background: #020C06; border: 1px solid var(--accent); border-radius: 16px; padding: 20px; max-width: 440px; margin: 25px auto; text-align: center; font-family: var(--font-mono); }
  .pong-screen { position: relative; width: 100%; height: 200px; background: #000; border: 2px solid var(--rule); border-radius: 8px; margin: 12px 0; overflow: hidden; }
  #pongCanvas { width: 100%; height: 100%; display: block; }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body);
    line-height: 1.6; overflow-x: hidden; transition: background 0.4s ease, color 0.4s ease;
  }
  body.wenamecha-active { border: 4px solid var(--accent); box-shadow: inset 0 0 40px rgba(76, 134, 255, 0.5), 0 0 25px rgba(76, 134, 255, 0.4); }

  ::selection { background: var(--accent); color: #03050B; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 28px; position: relative; z-index: 1; }
  img, svg { max-width: 100%; display: inline-block; object-fit: contain; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4 { font-family: var(--font-display); margin: 0; letter-spacing: -0.01em; }

  .gradient-text {
    background: linear-gradient(100deg, var(--ink) 0%, var(--accent-2) 55%, var(--accent) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* GLASSMORPHISM Y BORDES CON GRADIENTES TENUES */
  .glass-panel {
    background: var(--panel);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* NAVBAR */
  .navbar { 
    position: sticky; top: 0; z-index: 40; padding: 14px 0; 
    background: rgba(3, 5, 11, 0.82); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--rule); transition: all 0.3s ease;
  }
  .navrow { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 16px; display: flex; align-items: center; gap: 8px; white-space: nowrap; flex-shrink: 0; }
  .brand .mark { color: var(--accent); font-size: 18px; }
  
  .navlinks { display: flex; gap: 18px; font-size: 13.5px; color: var(--ink-dim); align-items: center; flex-wrap: wrap; }
  .navlinks a { white-space: nowrap; transition: color 0.25s ease, transform 0.25s ease; display: inline-block; }
  .navlinks a:hover { color: var(--ink); transform: translateY(-1px); }

  .navlinks a.secret-tab {
    color: var(--accent-2); font-weight: 600; font-size: 12px; background: rgba(76, 134, 255, 0.15);
    padding: 5px 10px; border-radius: 8px; border: 1px solid rgba(76, 134, 255, 0.4);
    animation: glowPulse 2s infinite ease-in-out;
  }
  @keyframes glowPulse { 0%, 100% { box-shadow: 0 0 5px rgba(76, 134, 255, 0.2); } 50% { box-shadow: 0 0 15px rgba(76, 134, 255, 0.6); } }

  .navright { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .link-ghost { font-size: 13.5px; color: var(--ink-dim); transition: color 0.2s; white-space: nowrap; }
  .link-ghost:hover { color: var(--ink); }
  .btn-solid {
    background: linear-gradient(135deg, var(--accent-2), var(--accent-deep));
    color: #05070D; font-weight: 600; font-size: 13px; padding: 9px 18px; border-radius: 10px;
    transition: transform 0.2s ease, box-shadow 0.2s ease; white-space: nowrap; border: none; cursor: pointer;
  }
  .btn-solid:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(76,134,255,0.3); }

  /* HERO */
  .hero { position: relative; padding: 70px 0 0; text-align: center; overflow: hidden; }
  .horizon-glow {
    position: absolute; top: 30px; left: 50%; transform: translateX(-50%);
    width: 1300px; height: 1300px; border-radius: 50%;
    background: radial-gradient(circle at 50% 28%, rgba(76,134,255,0.30), rgba(20,40,90,0.06) 42%, transparent 62%);
    filter: blur(10px); pointer-events: none;
  }
  .horizon-rim {
    position: absolute; top: 168px; left: 50%; transform: translateX(-50%);
    width: 880px; height: 880px; border-radius: 50%;
    border-top: 2px solid rgba(150, 190, 255, 0.85); box-shadow: 0 -12px 70px 8px rgba(76,134,255,0.55);
    pointer-events: none;
  }
  .hero-content { position: relative; z-index: 2; }

  .badge {
    display: inline-flex; align-items: center; gap: 8px; background: rgba(76,134,255,0.12);
    border: 1px solid rgba(140,175,255,0.35); color: var(--accent-2); font-size: 12.5px;
    padding: 7px 16px; border-radius: 999px; margin-bottom: 24px;
  }
  .badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 8px var(--accent-2); }

  .hero h1 { font-size: clamp(2.4rem, 6vw, 3.9rem); font-weight: 700; line-height: 1.1; }
  .hero p.lead { color: var(--ink-dim); font-size: 1.05rem; max-width: 52ch; margin: 22px auto 34px; font-weight: 300; }

  /* SIMULADOR EN HERO */
  .hero-simulator {
    background: var(--panel-2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px;
    padding: 16px 20px; max-width: 720px; margin: 0 auto 36px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4); text-align: left; backdrop-filter: blur(12px);
  }
  .sim-tag-title { font-family: var(--font-mono); font-size: 11px; color: var(--accent-2); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
  .sim-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
  .sim-btn {
    background: var(--card-bg); border: 1px solid var(--rule); color: var(--ink); padding: 8px 14px;
    border-radius: 8px; font-family: var(--font-mono); font-size: 12px; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;
  }
  .sim-btn:hover { border-color: var(--accent); background: rgba(76, 134, 255, 0.15); transform: translateY(-2px); }
  .sim-btn.bad:hover { border-color: var(--bad); background: rgba(248, 120, 138, 0.15); }

  /* DASHBOARD MOCKUP */
  .mockup-wrap { position: relative; z-index: 2; padding: 0 16px 40px; }
  .mockup {
    max-width: 980px; margin: 0 auto; background: var(--panel); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 18px;
    box-shadow: 0 40px 90px rgba(0,0,0,0.55), 0 0 0 1px rgba(76,134,255,0.06); overflow: hidden;
    display: grid; grid-template-columns: 170px 1fr 230px; transition: border-color 0.3s ease; backdrop-filter: blur(12px);
  }
  .mockup:hover { border-color: rgba(76, 134, 255, 0.3); }
  @media (max-width: 860px) { .mockup { grid-template-columns: 1fr; } .mockup .sidebar, .mockup .notif { display: none; } }

  .sidebar { border-right: 1px solid var(--rule); padding: 18px 14px; font-size: 12.5px; }
  .sidebar .sbrand { font-family: var(--font-display); font-weight: 700; font-size: 12.5px; margin-bottom: 18px; color: var(--ink); display:flex; align-items:center; gap:6px;}
  .sidebar .grp { color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; margin: 14px 0 8px; }
  .sidebar .item { padding: 7px 8px; border-radius: 7px; color: var(--ink-dim); margin-bottom: 2px; }
  .sidebar .item.active { background: rgba(76,134,255,0.14); color: var(--accent-2); font-weight: 600; }

  .maincol { padding: 18px 22px; }
  .mtop { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: var(--muted); margin-bottom: 16px; }
  .search-fake { background: var(--panel-2); border: 1px solid var(--rule); border-radius: 8px; padding: 6px 12px; font-size: 11px; color: var(--muted); }
  .mtitle { font-family: var(--font-display); font-weight: 600; font-size: 15px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; }

  table.mock-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
  table.mock-table th { text-align: left; color: var(--muted); font-weight: 500; padding-bottom: 8px; border-bottom: 1px solid var(--rule); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.03em; }
  table.mock-table td { padding: 10px 6px; border-bottom: 1px solid var(--rule); color: var(--ink-dim); }
  table.mock-table tr.new-row { animation: highlightRow 1.2s ease-out; }
  @keyframes highlightRow { 0% { background: rgba(76, 134, 255, 0.3); } 100% { background: transparent; } }
  table.mock-table td:first-child { color: var(--ink); font-family: var(--font-mono); font-size: 11px; }
  .pill-status { font-size: 10px; padding: 3px 9px; border-radius: 999px; display: inline-block; font-weight: 600; }
  .pill-status.ok { background: rgba(85,224,138,0.14); color: var(--ok); border: 1px solid rgba(85,224,138,0.3); }
  .pill-status.bad { background: rgba(248,120,138,0.14); color: var(--bad); border: 1px solid rgba(248,120,138,0.3); }

  .notif { padding: 18px 16px; font-size: 11.5px; border-left: 1px solid var(--rule); }
  .notif h4 { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 12px; }
  .notif-item { display: flex; gap: 8px; margin-bottom: 14px; animation: fadeIn 0.4s ease; }
  .notif-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-2); margin-top: 5px; flex-shrink: 0; }
  .notif-dot.bad { background: var(--bad); }
  .notif-item p { margin: 0; color: var(--ink-dim); line-height: 1.3; }
  .notif-item span { display:block; color: var(--muted); font-size: 10px; margin-top: 2px; }

  /* DIVISOR */
  .section-divider {
    position: relative; width: 100%; height: 100px; margin: 0 auto; pointer-events: none; display: flex; align-items: center; justify-content: center;
  }
  .section-divider::before {
    content: ""; position: absolute; width: 100%; height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(76, 134, 255, 0.25) 50%, transparent 100%);
  }

  .section { padding: 50px 0; position: relative; }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; color: var(--accent-2); display: flex; align-items: center; gap: 8px; margin-bottom: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .eyebrow::before { content: "•"; color: var(--accent-2); font-size: 14px; }

  /* SECCIÓN: QUÉ ES LA MANILLA */
  .manilla-head { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: center; margin-bottom: 40px; }
  @media (max-width: 850px) { .manilla-head { grid-template-columns: 1fr; } }
  
  .manilla-head h2 { font-size: 2.2rem; font-weight: 700; max-width: 18ch; line-height: 1.25; margin-bottom: 20px; }
  .manilla-head p { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; max-width: 48ch; font-weight: 300; }

  .nfc-visual-box { position: relative; background: transparent; border: none; min-height: 260px; display: flex; align-items: center; justify-content: center; }
  .nfc-rings {
