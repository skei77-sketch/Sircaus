  <!-- SECCIÓN 6: CÓDIGO -->
  <section class="section wrap" id="codigo">
    <div class="eyebrow">DESCARGA Y FIRMWARE</div>
    <h2>Código C++ y Diagramas de Conexión</h2>
    <p style="color:var(--ink-dim); max-width:60ch;">Firmware estructurado para el IDE de Arduino y simuladores en línea como Wokwi:</p>

    <div class="code-container">
      <div class="code-header">
        <span>firmware_sircaus_esp32.ino</span>
        <button class="copy-btn" id="copyBtn" onclick="copyCode()">
          <span id="copyBtnIcon">📋</span> <span id="copyBtnText">Copiar Código</span>
        </button>
      </div>
<pre><code id="cppCodeBlock"><span class="cpp-inc">#include</span> <span class="cpp-str">&lt;SPI.h&gt;</span>
<span class="cpp-inc">#include</span> <span class="cpp-str">&lt;MFRC522.h&gt;</span>

<span class="cpp-kw">#define</span> SS_PIN    <span class="cpp-num">5</span>
<span class="cpp-kw">#define</span> RST_PIN   <span class="cpp-num">4</span>
<span class="cpp-kw">#define</span> LED_VERDE <span class="cpp-num">26</span>
<span class="cpp-kw">#define</span> LED_ROJO  <span class="cpp-num">25</span>
<span class="cpp-kw">#define</span> BUZZER    <span class="cpp-num">33</span>

<span class="cpp-fn">MFRC522</span> <span class="cpp-fn">rfid</span>(SS_PIN, RST_PIN);

<span class="cpp-kw">void</span> <span class="cpp-fn">setup</span>() {
  <span class="cpp-fn">Serial</span>.<span class="cpp-fn">begin</span>(<span class="cpp-num">115200</span>);
  <span class="cpp-fn">SPI</span>.<span class="cpp-fn">begin</span>();
  rfid.<span class="cpp-fn">PCD_Init</span>();
  
  <span class="cpp-fn">pinMode</span>(LED_VERDE, <span class="cpp-kw">OUTPUT</span>);
  <span class="cpp-fn">pinMode</span>(LED_ROJO, <span class="cpp-kw">OUTPUT</span>);
  <span class="cpp-fn">pinMode</span>(BUZZER, <span class="cpp-kw">OUTPUT</span>);
}

<span class="cpp-kw">void</span> <span class="cpp-fn">loop</span>() {
  <span class="cpp-com">// Detectar si hay una nueva manilla NFC presente</span>
  <span class="cpp-kw">if</span> (!rfid.<span class="cpp-fn">PICC_IsNewCardPresent</span>() || !rfid.<span class="cpp-fn">PICC_ReadCardSerial</span>()) <span class="cpp-kw">return</span>;
  
  <span class="cpp-com">// Procesar lectura del UID de la manilla</span>
  <span class="cpp-fn">tone</span>(BUZZER, <span class="cpp-num">2000</span>, <span class="cpp-num">100</span>);
  <span class="cpp-fn">digitalWrite</span>(LED_VERDE, <span class="cpp-kw">HIGH</span>);
  <span class="cpp-fn">delay</span>(<span class="cpp-num">1000</span>);
  <span class="cpp-fn">digitalWrite</span>(LED_VERDE, <span class="cpp-kw">LOW</span>);
}</code></pre>
    </div>

